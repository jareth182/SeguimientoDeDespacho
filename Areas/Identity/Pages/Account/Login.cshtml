@page
@model LoginModel

@{
    ViewData["Title"] = "Inicio de Sesión";
    Layout = "/Views/Shared/_Layout.cshtml"; // Usa el Layout Público
}

@section Scripts {
    <link rel="stylesheet" href="~/css/login-styles.css" asp-append-version="true" />
    <partial name="_ValidationScriptsPartial" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <style>
        /* 1. Hace que el contenedor 'form-floating' sea el punto de referencia */
        .form-floating {
            position: relative;
        }

        /* 2. Posiciona el icono del "ojito" */
        #toggle-password {
            position: absolute;
            top: 50%; /* Lo centra verticalmente */
            right: 1rem; /* 16px desde la derecha */
            transform: translateY(-50%);
            cursor: pointer;
            z-index: 3; /* MUY importante: Pone el icono por encima del label */
            color: #6c757d; /* Color gris */
        }

        /* 3. Añade espacio al input para que el texto no se pise con el icono */
        #password-field {
            padding-right: 3.5rem !important; 
        }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const togglePassword = document.getElementById('toggle-password');
            const passwordField = document.getElementById('password-field');

            if (togglePassword && passwordField) {
                togglePassword.addEventListener('click', function (e) {
                    // Cambia el tipo de input
                    const type = passwordField.getAttribute('type') === 'password' ? 'text' : 'password';
                    passwordField.setAttribute('type', type);
                    
                    // Cambia el ícono (usando FontAwesome)
                    const icon = this.querySelector('i');
                    icon.classList.toggle('fa-eye');
                    icon.classList.toggle('fa-eye-slash');
                });
            }
        });
    </script>
}
<div class="login-container">
    <div class="login-box">

        <div class="login-logo">
            <a class="login-logo-text" asp-controller="Home" asp-action="Index">Logistica <strong>BROKER</strong></a>
        </div>

        <h2 class="login-title">INICIO DE SESION</h2>
        
        <form id="account" method="post">
            
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="hola@example.com" />
                <label asp-for="Input.Email" class="form-label">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" id="password-field" autocomplete="current-password" aria-required="true" placeholder="Contraseña" />
                <label asp-for="Input.Password" class="form-label">Contraseña</label>
                
                <span id="toggle-password">
                     <i class="fas fa-eye"></i> </span>
                
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            
            <div class="checkbox mb-3">
                <label asp-for="Input.RememberMe" class="form-label">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                </label>
            </div>

            <div>
                <button id="login-submit" type="submit" class="btn btn-primary">CONTINUAR</button>
            </div>

            <div class="login-links">
                <a id="forgot-password" asp-page="./ForgotPassword">Go back</a>
                 </div>
        </form>
    </div>

    <div class="login-footer">
        <a href="#">Terms of Use</a> | <a href="#">Privacy Policy</a>
    </div>
</div>