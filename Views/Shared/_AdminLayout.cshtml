<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Logistica BROKER</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin-layout.css" asp-append-version="true" />
    
</head>
<body>
    <div class="wrapper">

        <header class="main-header navbar navbar-expand navbar-dark">
            <a href="#" class="navbar-brand d-lg-none"><span class="brand-text">Logistica <strong>BROKER</strong></span></a>
            <ul class="navbar-nav"><li class="nav-item"><a class="nav-link sidebar-toggle-btn" href="#" role="button"><i class="fas fa-bars"></i></a></li></ul>
            <ul class="navbar-nav ms-auto"><li class="nav-item dropdown d-flex align-items-center"><partial name="_LoginPartial" /></li></ul>
        </header>
        <aside class="main-sidebar">
            <a asp-controller="Home" asp-action="Index" class="brand-link d-none d-lg-block"><span class="brand-text">Logistica <strong>BROKER</strong></span></a>
            <nav class="sidebar-nav">
                <ul class="nav nav-pills nav-sidebar flex-column">
                    @if (User.IsInRole("Admin")) {
                        <li class="nav-item"><a asp-controller="PanelLogistico" asp-action="Index" class="nav-link active"><i class="nav-icon fas fa-tachometer-alt"></i><p>Dashboard</p></a></li>
                        <li class="nav-item has-treeview">
                             <a href="#" class="nav-link"><i class="nav-icon fas fa-users"></i><p>GESTOR CLIENTES<i class="right fas fa-angle-left"></i></p></a>
                             <ul class="nav nav-treeview">
                                 <li class="nav-item"><a href="#" class="nav-link"><i class="fas fa-plus nav-icon"></i> <p>AGREGAR CLIENTE</p></a></li>
                                 <li class="nav-item"><a href="#" class="nav-link"><i class="fas fa-list-ul nav-icon"></i> <p>LISTA DE CLIENTE</p></a></li>
                             </ul>
                        </li>
                        <li class="nav-item"><a href="#" class="nav-link"><i class="nav-icon fas fa-chart-bar"></i> <p>REPORTE</p></a></li>
                        <li class="nav-item"><a href="#" class="nav-link"><i class="nav-icon fas fa-truck"></i> <p>SEGUIMIENTO</p></a></li>
                        <li class="nav-item"><a href="#" class="nav-link"><i class="nav-icon fas fa-cog"></i> <p>CONFIGURACION</p></a></li>
                    } else if (User.IsInRole("Cliente")) {
                        <li class="nav-item"><a asp-controller="EstadoEnvio" asp-action="Index" class="nav-link active"><i class="nav-icon fas fa-box"></i><p>Estado de su Envío</p></a></li>
                    }
                </ul>
            </nav>
        </aside>

        <main class="content-wrapper">
            @RenderBody()
        </main>
        <div id="sidebar-overlay" class="sidebar-overlay"></div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.js"></script>
    
    <script>
        $(document).ready(function () {
            
            $('.nav-item.has-treeview > .nav-link').on('click', function (e) {
                e.preventDefault();
                var $parentLi = $(this).closest('li');
                var $submenu = $parentLi.children('.nav-treeview');

                $('.nav-item.has-treeview.menu-open').not($parentLi).removeClass('menu-open').children('.nav-treeview').slideUp(200);
                
                $parentLi.toggleClass('menu-open');
                $submenu.slideToggle(200); 
            });

            $('.sidebar-toggle-btn').on('click', function (e) {
                e.preventDefault();
                $('body').toggleClass('sidebar-open');
            });

            $('#sidebar-overlay').on('click', function (e) {
                e.preventDefault();
                $('body').removeClass('sidebar-open');
            });
        });
    </script>
    
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 2000">
        <div id="eventoToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <i class="fas fa-check-circle text-success me-2"></i>
                <strong class="me-auto">Panel Logístico</strong>
                <small>Justo ahora</small>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Cerrar"></button>
            </div>
            <div class="toast-body">
                Tu evento se ha guardado correctamente.
            </div>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>