@model PanelLogisticoViewModel
@using SeguimientoDeDespacho.Models
@{
    ViewData["Title"] = "Panel Logístico";
    Layout = "_AdminLayout";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Panel Logístico</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Panel Logístico</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">

            <div class="col-lg-8">
                <div class="row">
                    <div class="col-lg-6 col-12">
                        <div class="small-box bg-info">
                            <div class="inner">
                                <h3>@Model.TotalDespachos</h3>
                                <p>Total Despacho</p>
                            </div>
                            <div class="icon"><i class="fas fa-box"></i></div>
                            <a asp-controller="ListadoDespachos" asp-action="Index" class="small-box-footer">
                                Más info <i class="fas fa-arrow-circle-right"></i>
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-6 col-12">
                        <div class="small-box bg-primary">
                            <div class="inner">
                                <h3>@Model.DespachosEnProceso</h3>
                                <p>Despacho en Proceso</p>
                            </div>
                            <div class="icon"><i class="fas fa-truck-loading"></i></div>
                            <a asp-controller="ListadoDespachos" asp-action="Index"
                               asp-route-filtroEstado="@EstadoDespacho.EnProceso.ToString()" class="small-box-footer">
                                Más info <i class="fas fa-arrow-circle-right"></i>
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-6 col-12">
                        <div class="small-box bg-warning">
                            <div class="inner">
                                <h3>@Model.DespachosCulminados</h3>
                                <p>Despachos Culminados</p>
                            </div>
                            <div class="icon"><i class="fas fa-check-circle"></i></div>
                            <a asp-controller="ListadoDespachos" asp-action="Index"
                               asp-route-filtroEstado="@EstadoDespacho.Culminado.ToString()" class="small-box-footer">
                                Más info <i class="fas fa-arrow-circle-right"></i>
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-6 col-12">
                        <div class="small-box bg-success">
                            <div class="inner">
                                <h3>@Model.IndicadorRendimiento<sup style="font-size: 20px">%</sup></h3>
                                <p>Indicadores (Rendimiento)</p>
                            </div>
                            <div class="icon"><i class="fas fa-chart-pie"></i></div>
                            <a href="#" class="small-box-footer">
                                Más info <i class="fas fa-arrow-circle-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light">
                        <h3 class="card-title mb-0"><i class="fas fa-tasks me-2"></i>Gestión Diaria</h3>
                    </div>
                    <div class="card-body p-0">
                        <ul class="nav nav-pills flex-column">
                            <li class="nav-item">
                                <a href="#" class="nav-link">
                                    Agendado
                                    <span id="contador-agendado" class="badge bg-primary float-end">@Model.TareasAgendadas.Count</span>
                                </a>
                                <ul id="lista-agendado" class="list-unstyled ps-4 pt-1 pb-1">
                                    @foreach (var tarea in Model.TareasAgendadas)
                                    {
                                        <li data-id="@tarea.Id">
                                            <i class="fas fa-xs fa-chevron-right me-1"></i> @tarea.Titulo
                                        </li>
                                    }
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a href="#" class="nav-link">
                                    Mensajes
                                    <span id="contador-mensajes" class="badge bg-danger float-end">@Model.MensajesNuevos.Count</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h3 class="card-title mb-0"><i class="fas fa-calendar-alt me-2"></i>Calendario</h3>
                    </div>
                    <div class="card-body">
                        <div id="calendar-widget-simple"></div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<div class="modal fade" id="addEventModal" tabindex="-1" aria-labelledby="addEventModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addEventModalLabel">Agregar Tarea / Evento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form>
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="eventDate" class="form-label">Fecha seleccionada</label>
                        <input type="text" class="form-control" id="eventDate" readonly />
                    </div>
                    <div class="mb-3">
                        <label for="eventTitle" class="form-label">Título del evento</label>
                        <input type="text" class="form-control" id="eventTitle" placeholder="Ej: Reunión de equipo" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                
                <button type="button" id="btnGuardarEvento" class="btn btn-primary">Guardar Evento (HU05)</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {
        
        const addEventModal = new bootstrap.Modal(document.getElementById('addEventModal'));
        
        // ---- INICIO DE LÓGICA HU05 (CRITERIO 2) ----
        
        $('#btnGuardarEvento').on('click', function () {
            
            // a. Obtener los datos del modal
            var tituloEvento = $('#eventTitle').val();
            var fechaEvento = $('#eventDate').val();
            
            // b. Obtener el token de seguridad
            var token = $('input[name="__RequestVerificationToken"]').val();

            // c. Enviar datos al controlador vía AJAX
            $.ajax({
                url: '@Url.Action("GuardarEvento", "PanelLogistico")', // Llama a la acción del controlador
                type: 'POST',
                data: {
                    __RequestVerificationToken: token, // Envía el token
                    titulo: tituloEvento,
                    fecha: fechaEvento
                },
                success: function (response) {
                    if (response.success) {
                        
                        // d. Actualizar la lista "Agendado" dinámicamente
                        var nuevaTarea = response.tarea;
                        var tareaHtml = '<li data-id="' + nuevaTarea.id + '">' +
                                        '<i class="fas fa-xs fa-chevron-right me-1"></i> ' +
                                        nuevaTarea.titulo +
                                      '</li>';
                        $('#lista-agendado').append(tareaHtml);

                        // e. Actualizar el contador "Agendado"
                        var contadorSpan = $('#contador-agendado');
                        var contadorActual = parseInt(contadorSpan.text()) || 0;
                        contadorSpan.text(contadorActual + 1);

                        // f. Cerrar y limpiar el modal
                        addEventModal.hide();
                        $('#eventTitle').val('');
                        $('#eventDate').val('');

                    } else {
                        alert('Error al guardar: ' + response.message);
                    }
                },
                error: function () {
                    alert('No se pudo conectar con el servidor.');
                }
            });
        });
        
        // ---- FIN DE LÓGICA HU05 ----
        
        
        // ---- INICIO LÓGICA HU04 (Tu script de calendario) ----
        const calendarEl = document.getElementById('calendar-widget-simple');

        if (calendarEl) {
            const calendar = new FullCalendar.Calendar(calendarEl, {
                
                initialView: 'dayGridMonth', 
                locale: 'es', 
                height: 'auto', 
                headerToolbar: {
                    left: 'prev', 
                    center: 'title', 
                    right: 'next'  
                },

                dateClick: function(info) {
                    document.getElementById('eventDate').value = info.dateStr;
                    addEventModal.show();
                }
            });

            calendar.render();

        } else {
            console.error("Error: no se encontró el elemento #calendar-widget-simple");
        }
        // ---- FIN LÓGICA HU04 ----
    });
</script>
}