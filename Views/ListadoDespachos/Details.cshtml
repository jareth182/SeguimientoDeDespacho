@model SeguimientoDeDespacho.Models.Despacho
@{
    ViewData["Title"] = "Detalles del Despacho";
    Layout = "_AdminLayout";
}

<h1>@ViewData["Title"]</h1>
<h4>Detalles para la Guía: @Model.NumeroGuia</h4>
<hr />

<div class="card shadow-sm">
    <div class="card-header">
        Información del Despacho
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.NumeroGuia)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.NumeroGuia)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.ClienteNombre)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.ClienteNombre)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Estado)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Estado)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.FechaCreacion)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.FechaCreacion)
            </dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
</div>